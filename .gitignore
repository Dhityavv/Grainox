# Python & Virtual Environment
backend/.venv/
**/__pycache__/
*.py[cod]

# Heavy ONNX model binaries (auto-downloaded at runtime)
backend/models/*.onnx
backend/models/*.onnx.part

# Runtime media storage
backend/storage/uploads/*
backend/storage/outputs/*
backend/storage/previews/*
!backend/storage/**/.gitkeep

# Frontend
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Vercel & Environment
.vercel
.env
.env*
